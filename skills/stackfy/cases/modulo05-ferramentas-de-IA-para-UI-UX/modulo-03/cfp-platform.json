              "email": "bruno@example.com",
              "talkTitle": "Testing NestJS APIs",
              "isGDE": false
            }
          ]
        }
      ],
      "serve": {
        "port": 47531,
        "ready": "/",
        "page": {
          "path": "/",
          "steps": [
            {
              "wait": "document.querySelectorAll('tbody tr').length === 2"
            },
            {
              "read": "[location.pathname, document.title]"
            },
            {
              "read": "[...document.querySelectorAll('nav a')].map((link) => [link.textContent.trim(), link.getAttribute('href'), link.classList.contains('active')])"
            },
            {
              "read": "[document.querySelector('h1').textContent.trim(), document.querySelector('.subtitle').textContent.trim()]"
            },
            {
              "read": "(() => { const region = document.querySelector('[role=region]'); return [region.getAttribute('aria-label'), [...region.querySelectorAll('th')].map((header) => [header.textContent.trim(), header.getAttribute('scope')])]; })()"
            },
            {
              "read": "[...document.querySelectorAll('tbody tr')].map((row) => [...row.querySelectorAll('td')].map((cell) => cell.textContent.trim()))"
            },
            {
              "read": "[...document.querySelectorAll('tbody .badge')].map((badge) => [badge.textContent.trim(), badge.classList.contains('badge-gde'), getComputedStyle(badge).backgroundImage])"
            },
            {
              "read": "[...document.querySelectorAll('.actions a')].map((link) => [link.textContent.trim(), link.getAttribute('href')])"
            },
            {
              "read": "[document.querySelector('[role=status]') === null, document.querySelector('[role=alert]') === null, getComputedStyle(document.querySelector('nav a.active')).backgroundImage]"
            },
            {
              "click": "nav a[href='/event/new']"
            },
            {
              "wait": "document.querySelector('#nome') !== null"
            },
            {
              "read": "[location.pathname, [...document.querySelectorAll('nav a.active')].map((link) => link.textContent.trim())]"
            },
            {
              "read": "[getComputedStyle(document.querySelector('.cfp-container')).backgroundImage, getComputedStyle(document.querySelector('.glass-card')).maxWidth]"
            },
            {
              "click": "a.dashboard-link"
            },
            {
              "wait": "document.querySelectorAll('tbody tr').length === 2"
            },
            {
              "read": "[location.pathname, [...document.querySelectorAll('nav a.active')].map((link) => link.textContent.trim())]"
            },
            {
              "read": "[getComputedStyle(document.querySelector('.cfp-container')).backgroundImage, getComputedStyle(document.querySelector('.glass-card')).maxWidth]"
            }
          ]
        }
      },
