            "method": "POST",
            "path": "/chat",
            "json": { "question": "What is the weather today?" }
          }
        ]
      },
      "expect": [
        {
          "type": "responses",
          "responses": [
            {
              "status": 200,
              "match": {
                "messages": {
                  "$like": [
                    {
                      "lc": 1,
                      "type": "constructor",
                      "id": ["langchain_core", "messages", "HumanMessage"],
                      "kwargs": {
                        "content": "Olá, sou Maria Santos e quero agendar uma consulta com Dr. Alicio da Silva para amanhã às 16h para um check-up regular",
                        "additional_kwargs": {},
                        "response_metadata": {}
                      }
                    }
                  ]
                }
              },
              "pattern": "^\\{\\s*\"messages\"\\s*:\\s*\\[\\s*\\{[\\s\\S]*\"id\"\\s*:\\s*\"[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\"[\\s\\S]*\\}\\s*\\]\\s*\\}$"
            },
            {
              "status": 200,
              "match": {
                "messages": {
                  "$like": [
                    {
                      "lc": 1,
                      "type": "constructor",
                      "id": ["langchain_core", "messages", "HumanMessage"],
                      "kwargs": {
                        "content": "Cancele minha consulta com Dra. Ana Pereira que tenho hoje às 14h, me chamo Joao da Silva",
                        "additional_kwargs": {},
                        "response_metadata": {}
                      }
                    }
