              "pattern": "^\\{\\s*\"messages\"\\s*:\\s*\\[\\s*\\{[\\s\\S]*\"id\"\\s*:\\s*\"[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\"[\\s\\S]*\\}\\s*\\]\\s*\\}$"
            },
            {
              "status": 200,
              "match": {
                "messages": {
                  "$like": [
