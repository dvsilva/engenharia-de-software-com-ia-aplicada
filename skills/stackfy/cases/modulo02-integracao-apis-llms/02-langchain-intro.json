              "match": { "statusCode": 400, "error": "Bad Request" },
              "pattern": "\"message\"\\s*:\\s*\"[^\"]+\""
            },
            {
              "status": 400,
              "match": { "statusCode": 400, "error": "Bad Request" },
              "pattern": "\"message\"\\s*:\\s*\"[^\"]+\""
            },
            {
              "status": 400,
              "match": { "statusCode": 400, "error": "Bad Request" },
              "pattern": "\"message\"\\s*:\\s*\"[^\"]+\""
            },
            {
              "status": 400,
              "match": { "statusCode": 400, "error": "Bad Request" },
              "pattern": "\"message\"\\s*:\\s*\"[^\"]+\""
            },
            {
              "status": 400,
              "match": { "statusCode": 400, "error": "Bad Request" },
              "pattern": "\"message\"\\s*:\\s*\"[^\"]+\""
            },
            {
              "status": 400,
              "match": { "statusCode": 400, "error": "Bad Request" },
              "pattern": "\"message\"\\s*:\\s*\"[^\"]+\""
            },
            {
              "status": 415,
              "match": { "statusCode": 415, "error": "Unsupported Media Type" },
              "pattern": "\"message\"\\s*:\\s*\"[^\"]+\""
            },
            {
              "status": 404,
              "match": {
                "statusCode": 404,
                "error": "Not Found",
                "message": "Route GET:/chat not found"
              }
            }
          ]
        },
        { "type": "output", "pattern": "^server running at 47863\\n$" },
        { "type": "output", "stream": "stderr", "pattern": "^$" },
        { "type": "requests", "requests": [] }
      ]
    },
    {
      "name": "the tests send the three commands through the route and pass",
      "program": "tests/router.e2e.test",
      "expect": [
        { "type": "exit", "code": 0 },
        { "type": "requests", "requests": [] }
      ]
    }
  ]
