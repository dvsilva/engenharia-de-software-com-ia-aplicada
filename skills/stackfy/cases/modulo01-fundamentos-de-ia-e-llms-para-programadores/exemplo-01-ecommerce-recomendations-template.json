              "Óculos de Sol acessórios Price: $89.99 Color: marrom Buy Now"
            ],
            [true, true, true, true, true, true, true, true, true, true],
            [false, true],
            false,
            [
              ["Josézin da Silva (Age: 30)", "No purchases"],
              [
                "Ana Lima (Age: 25)",
                "Fones de Ouvido Sem Fio",
                "Relógio Inteligente"
              ],
              [
                "Bruno Ferreira (Age: 27)",
                "Fones de Ouvido Sem Fio",
                "Caixa de Som Bluetooth"
              ],
              [
                "Camila Souza (Age: 30)",
                "Camiseta Estampada",
                "Calça Jeans Slim"
              ],
              [
                "Diego Almeida (Age: 22)",
                "Relógio Inteligente",
                "Caixa de Som Bluetooth",
