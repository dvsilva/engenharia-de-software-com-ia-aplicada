{
  "module": "modulo01-fundamentos-de-ia-e-llms-para-programadores/exemplo-01-ecommerce-recomendations-template",
  "concepts": ["browser-app", "neural-network-training"],
  "recorded": "Original served by browser-sync 3.0.4 and driven in headless Google Chrome 152. It ran with npx browser-sync . --server --port $PORT --no-open --no-ui --no-notify instead of npm start, which fixes port 3000 and opens a browser, and no file was patched. TensorFlow.js, tfjs-vis, and Bootstrap come from jsdelivr, so the page needs network access. The behavior is deterministic, and every case passed in each of 20 runs.",
  "originals": [
    "npx browser-sync . --server --port $PORT --no-open --no-ui --no-notify"
  ],
  "cases": [
    {
      "name": "lists the users, the products, and every user's purchases, and trains once on load",
      "serve": {
        "port": 47310,
        "ready": "/",
        "page": {
          "steps": [
            {
              "wait": "document.querySelectorAll('#userSelect option').length === 7 && document.querySelectorAll('#productList .product-card').length === 10"
            },
            {
              "read": "[...document.querySelectorAll('#userSelect option')].map((option) => [option.value, option.innerText.trim()])"
            },
            {
              "read": "[...document.querySelectorAll('#productList .product-card')].map((card) => card.innerText.replace(/\\s+/g, ' ').trim())"
            },
            {
              "read": "[...document.querySelectorAll('#productList .buy-now-btn')].map((button) => button.disabled)"
            },
            {
              "wait": "document.querySelector('#trainModelBtn').innerText.trim() === 'Train Recommendation Model'"
            },
            {
              "read": "[document.querySelector('#trainModelBtn').disabled, document.querySelector('#runRecommendationBtn').disabled]"
            },
            {
              "wait": "['Precisão do Modelo', 'Erro de Treinamento'].every((chart) => document.body.innerText.includes(chart))"
            },
            {
              "read": "document.querySelector('#allUsersPurchasesList')?.checkVisibility() ?? false"
            },
            { "click": "#purchasesDiv" },
            {
              "wait": "document.querySelector('#allUsersPurchasesList')?.checkVisibility()"
            },
            {
              "read": "[...document.querySelectorAll('#allUsersPurchasesList .user-purchase-summary')].map((summary) => [...summary.querySelectorAll('h6, span')].map((element) => element.innerText.trim()))"
            },
            { "click": "#purchasesDiv" },
            {
              "read": "document.querySelector('#allUsersPurchasesList')?.checkVisibility() ?? false"
            }
          ]
        }
      },
      "expect": [
        {
          "type": "page",
          "values": [
            [
              ["", "-- Select a user --"],
              ["99", "Josézin da Silva"],
              ["1", "Ana Lima"],
              ["2", "Bruno Ferreira"],
              ["3", "Camila Souza"],
              ["4", "Diego Almeida"],
