    {
      "name": "buying adds the product to the user's past purchases, newest first until the user is chosen again",
      "serve": {
        "port": 47310,
        "ready": "/",
        "page": {
          "steps": [
            {
              "wait": "document.querySelectorAll('#userSelect option').length === 7 && document.querySelector('#trainModelBtn').innerText.trim() === 'Train Recommendation Model'"
            },
            { "select": "#userSelect", "value": "1" },
            {
              "wait": "document.querySelector('#userAge').value === '25' && !document.querySelector('#productList .buy-now-btn').disabled"
            },
            { "click": "#productList > :nth-child(3) .buy-now-btn" },
