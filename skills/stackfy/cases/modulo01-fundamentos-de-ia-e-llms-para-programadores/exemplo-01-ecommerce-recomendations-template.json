            ]
          ]
        }
      ]
    },
    {
      "name": "clicking a past purchase removes it from the user's purchases",
      "serve": {
        "port": 47310,
        "ready": "/",
        "page": {
          "steps": [
            {
              "wait": "document.querySelectorAll('#userSelect option').length === 7 && document.querySelector('#trainModelBtn').innerText.trim() === 'Train Recommendation Model'"
            },
            { "select": "#userSelect", "value": "1" },
            {
              "wait": "document.querySelectorAll('#pastPurchasesList .past-purchase').length === 2"
            },
            { "click": "#pastPurchasesList .past-purchase" },
            {
              "wait": "document.querySelectorAll('#pastPurchasesList .past-purchase').length === 1"
            },
            {
              "read": "[...document.querySelectorAll('#pastPurchasesList .past-purchase')].map((purchase) => purchase.innerText.replace(/\\s+/g, ' ').trim())"
            },
            { "click": "#pastPurchasesList .past-purchase" },
            {
              "wait": "document.querySelectorAll('#pastPurchasesList .past-purchase').length === 0 && document.querySelector('#pastPurchasesList').innerText.trim() !== ''"
            },
            {
              "read": "document.querySelector('#pastPurchasesList').innerText.trim()"
            },
            { "click": "#purchasesDiv" },
            {
              "wait": "document.querySelector('#allUsersPurchasesList')?.checkVisibility()"
            },
            {
              "read": "[...document.querySelectorAll('#allUsersPurchasesList .user-purchase-summary')].map((summary) => [...summary.querySelectorAll('h6, span')].map((element) => element.innerText.trim()))[1]"
            }
          ]
        }
      },
      "expect": [
        {
          "type": "page",
          "values": [
            ["Relógio Inteligente - Price 199.99 - Color prata"],
            "No past purchases found.",
            ["Ana Lima (Age: 25)", "No purchases"]
          ]
        }
      ]
    },
    {
      "name": "training again disables the button until the worker finishes",
      "serve": {
        "port": 47310,
        "ready": "/",
        "page": {
          "steps": [
            {
              "wait": "document.querySelector('#trainModelBtn').innerText.trim() === 'Train Recommendation Model'"
            },
            { "click": "#trainModelBtn" },
            {
              "wait": "document.querySelector('#trainModelBtn').innerText.trim() === 'Training...'"
            },
            { "read": "document.querySelector('#trainModelBtn').disabled" },
            {
              "wait": "document.querySelector('#trainModelBtn').innerText.trim() === 'Train Recommendation Model'"
            },
            { "read": "document.querySelector('#trainModelBtn').disabled" }
          ]
        }
      },
      "expect": [{ "type": "page", "values": [true, false] }]
    },
    {
      "name": "running a recommendation leaves the catalog as it is",
      "serve": {
        "port": 47310,
        "ready": "/",
        "page": {
          "steps": [
            {
              "wait": "document.querySelectorAll('#userSelect option').length === 7 && document.querySelector('#trainModelBtn').innerText.trim() === 'Train Recommendation Model'"
            },
            { "select": "#userSelect", "value": "3" },
            {
              "wait": "!document.querySelector('#runRecommendationBtn').disabled"
            },
