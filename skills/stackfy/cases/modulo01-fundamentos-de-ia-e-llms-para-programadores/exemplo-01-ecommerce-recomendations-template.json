              ]
            ],
            false
          ]
        }
      ]
    },
    {
      "name": "shows the chosen user's age and past purchases and enables buying and recommending",
      "serve": {
        "port": 47310,
        "ready": "/",
        "page": {
          "steps": [
            {
              "wait": "document.querySelectorAll('#userSelect option').length === 7 && document.querySelector('#trainModelBtn').innerText.trim() === 'Train Recommendation Model'"
            },
            { "select": "#userSelect", "value": "1" },
            { "wait": "document.querySelector('#userAge').value === '25'" },
            {
              "read": "[...document.querySelectorAll('#pastPurchasesList .past-purchase')].map((purchase) => purchase.innerText.replace(/\\s+/g, ' ').trim())"
            },
            {
              "read": "[...document.querySelectorAll('#productList .buy-now-btn')].map((button) => button.disabled)"
            },
            {
              "read": "document.querySelector('#runRecommendationBtn').disabled"
            },
            { "select": "#userSelect", "value": "99" },
            { "wait": "document.querySelector('#userAge').value === '30'" },
            {
              "read": "document.querySelector('#pastPurchasesList').innerText.trim()"
            },
            { "select": "#userSelect", "value": "" },
            { "wait": "document.querySelector('#userAge').value === ''" },
            {
              "read": "document.querySelector('#pastPurchasesList').innerText.trim()"
            }
          ]
        }
      },
      "expect": [
