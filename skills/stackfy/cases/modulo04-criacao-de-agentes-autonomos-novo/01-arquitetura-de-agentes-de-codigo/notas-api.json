{
  "module": "modulo04-criacao-de-agentes-autonomos-novo/01-arquitetura-de-agentes-de-codigo/notas-api",
  "concepts": [
    "coding-agent-harness",
    "layered-architecture",
    "rest-api",
    "command-line-interface",
    "schema-validation"
  ],
  "recorded": "Every case passed against the original with Node.js 26, tsx 4.23, and zod 4.4.3, run as \"node --import tsx src/{program}.ts\". The module never calls an LLM. The original server always listens on port 3000, so the copy that produced these cases reads PORT first and falls back to 3000, a one-line change. Validation messages that come from zod defaults, such as a missing title or an unknown status filter, are checked only as a validation failure, while the messages the module writes itself are checked exactly. The CLI cases point TASK_CLI_STORE_PATH to tasks.json and seed it, except the one that checks the default path in the working directory.",
  "prepare": {
    "setup": ["npm ci"],
    "patches": [
      {
        "file": "src/index.ts",
        "find": "const port = 3000;",
        "replace": "const port = Number(process.env.PORT ?? 3000);"
      }
    ]
  },
  "originals": ["node --import tsx src/{program}.ts"],
  "cases": [
