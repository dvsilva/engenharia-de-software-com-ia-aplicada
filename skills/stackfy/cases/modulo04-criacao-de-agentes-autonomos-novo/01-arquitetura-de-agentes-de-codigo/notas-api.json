    {
      "name": "creates the store on first use with a trimmed open task",
      "program": "cli",
      "args": ["task", "create", "--title", "  Comprar leite  "],
      "env": {
        "TASK_CLI_STORE_PATH": "tasks.json"
      },
      "files": {
        "tasks.json": null
      },
      "expect": [
        {
          "type": "exit",
          "code": 0
        },
        {
          "type": "output",
          "pattern": "^Created task: [0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\topen\\tComprar leite\\n$"
        },
        {
          "type": "output",
          "stream": "stderr",
          "pattern": "^$"
        },
        {
          "type": "file",
          "path": "tasks.json",
          "pattern": "^\\s*\\{\\s*\"tasks\"\\s*:\\s*\\[\\s*\\{(?=[^{}]*\"id\"\\s*:\\s*\"[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\")(?=[^{}]*\"title\"\\s*:\\s*\"Comprar leite\")(?=[^{}]*\"status\"\\s*:\\s*\"open\")[^{}]*\\}\\s*\\]\\s*\\}\\s*$"
        }
      ]
    },
